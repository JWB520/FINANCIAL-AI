# 复制成 .env 即可（.env 不要提交）。键名与 app/config.py 的字段一一对应。
RQC_ENV=dev
RQC_DEBUG=true
# 接口前缀：前端 vite 代理就是按这个转发的，改了要同步前端
RQC_API_PREFIX=/api/v1
# 允许的前端来源（本地联调默认 5173；Electron 桌面端是 app://.）
RQC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","app://."]
# 演示期允许不带 Authorization（上线前必须改成 false）
RQC_ALLOW_ANONYMOUS_DEMO=true

# 存储
RQC_DATABASE_URL=postgresql+psycopg://rqc:rqc@localhost:5432/rqc
RQC_REDIS_URL=redis://localhost:6379/0
RQC_STORAGE_DIR=./var/storage

# 流水线
RQC_CHECK_CONCURRENCY=4
RQC_STAGE_RETRY_LIMIT=2

# 模型网关（演示用 deepseek；也可换 openai / anthropic / ollama 本地模型）
RQC_LLM_PROVIDER=deepseek
RQC_LLM_MODEL=deepseek-chat
RQC_LLM_API_KEY=
RQC_LLM_BASE_URL=
RQC_LLM_TEMPERATURE=0.2
