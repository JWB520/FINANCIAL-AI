# ===== 前端本地开发环境变量（这个文件可以进仓库，里面没有密钥）=====
#
# VITE_USE_MOCK：
#   true  = 所有接口请求走 src/api/mock/ 下的假数据，不需要后端也能完整演示
#   false = 真实请求后端（走 vite.config.ts 里配置的 /api 代理）
VITE_USE_MOCK=true

# 接口前缀。留空则用默认值 /api/v1（由 vite 代理转发到后端，见 vite.config.ts）
VITE_API_BASE_URL=/api/v1

# 后端地址（仅当不使用 vite 代理、想直连时填写，例如 http://localhost:8000/api/v1）
# VITE_API_DIRECT_URL=

# 每个请求的超时时间（毫秒）
VITE_REQUEST_TIMEOUT=15000